{
  "name": "2026may-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate:icpc-vietnam": "node scripts/buildIcpcVietnamScoreboards.mjs --write",
    "generate:lens": "node scripts/generateLensIndex.mjs",
    "check:lens": "node --test scripts/lensDocumentParser.test.mjs",
    "check:posts": "node --test scripts/postMetadata.test.mjs && node scripts/checkPublishedPosts.mjs",
    "post:new": "node scripts/createPostDraft.mjs",
    "post:publish": "node scripts/publishPost.mjs",
    "post:finish-publication": "node scripts/finishPostPublication.mjs",
    "post:mark-updated": "node scripts/markPostUpdated.mjs",
    "predev": "npm run check:posts && npm run check:lens && npm run generate:lens",
    "dev": "astro dev",
    "prebuild": "npm run check:posts && npm run check:lens && npm run generate:lens",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "astro": "^6.2.2",
    "katex": "^0.16.45",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "parse5": "^7.3.0"
  }
}
