---
import { Image } from 'astro:assets';
import portrait from '../assets/taein-oh.png';
import ProfileLayout from '../layouts/ProfileLayout.astro';
---

<ProfileLayout title="Taein Oh">
  <article class="profile-home">
    <section class="profile-intro" aria-labelledby="profile-name">
      <div class="profile-intro-copy">
        <h1 id="profile-name">Taein Oh</h1>
        <p class="profile-name-korean" lang="ko">오태인</p>

        <div class="profile-bio">
          <p>
            Hello. I am a graduate student in the <a href="https://cs.kaist.ac.kr/">School of Computing</a>, <a href="https://grasp-kaist.github.io/">GRASP Lab</a>. My advisor is <a href="https://www.wiederrecht.com/">Sebastian Wiederrecht</a>.
          </p>
          <p>Email: octanec8h18 (at) kaist . ac . kr</p>
        </div>
      </div>

      <figure class="profile-portrait">
        <Image
          src={portrait}
          alt="Portrait of Taein Oh"
          width={354}
          height={472}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <div class="profile-home-records">
      <section class="profile-home-record-section" aria-labelledby="position-heading">
        <h2 id="position-heading">&lt;Position&gt;</h2>
        <ul class="profile-home-record-list">
          <li>
            <span class="profile-keep-together">Sep. 2026 - Present</span> :
            M.S. program in <span class="profile-keep-together">School of Computing, KAIST</span>
          </li>
        </ul>
      </section>

      <section class="profile-home-record-section" aria-labelledby="education-heading">
        <h2 id="education-heading">&lt;Education&gt;</h2>
        <ul class="profile-home-record-list">
          <li>
            <span class="profile-keep-together">Mar. 2023 - Aug. 2026</span> :
            B.S. in <span class="profile-keep-together">Mathematical Sciences</span>
            and <span class="profile-keep-together">Computing</span>
            <span class="profile-keep-together">(Double Major), KAIST</span>
          </li>
        </ul>
      </section>
    </div>
  </article>
</ProfileLayout>
