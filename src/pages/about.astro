---
import BlogLayout from '../layouts/BlogLayout.astro';
import ProfileRecords from '../components/ProfileRecords.astro';
import profile from '../data/profile.json';
---

<BlogLayout title="About">
  <article class="cv-page">
    <header class="cv-header">
      <h1>{profile.name}</h1>
      <p>{profile.summary}</p>
    </header>

    {profile.about.map((section) => <section class="cv-section" aria-labelledby={`${section.id}-heading`}>
      <h2 id={`${section.id}-heading`}>{section.title}</h2>
      {section.groups.map((group) => 'title' in group ? (
        <div class="cv-subsection">
          <h3>{group.title}</h3>
          <ProfileRecords records={profile.records} ids={group.ids} style={group.style} />
        </div>
      ) : <ProfileRecords records={profile.records} ids={group.ids} style={group.style} />)}
    </section>)}

    <section class="cv-section" aria-labelledby="interests-heading">
      <h2 id="interests-heading">Interests</h2>
      <p>{profile.interests.join('; ')}</p>
    </section>

    <section class="cv-section" aria-labelledby="profiles-heading">
      <h2 id="profiles-heading">Online Profiles</h2>
      <ul class="cv-profile-list" aria-label="competitive programming profiles">
        {profile.profiles.map((entry) => <li>
          <a href={entry.url}>{entry.label}</a>
          <span>{entry.description}</span>
        </li>)}
      </ul>
    </section>

    <footer class="cv-downloads" aria-label="Download CVs">
      <p>
        <a href={`/cv/${profile.documents.academic.filename}`}>Academic CV (PDF)</a>
        <span aria-hidden="true"> · </span>
        <a href={`/cv/${profile.documents.general.filename}`}>General CV (PDF)</a>
      </p>
      <p class="cv-updated">Updated <time datetime={profile.updated}>{profile.updated}</time></p>
    </footer>
  </article>
</BlogLayout>

<style>
  .cv-downloads { border-top: 1px solid var(--line); padding-top: 20px; }
  .cv-downloads p { margin: 0; }
  .cv-downloads a { display: inline-block; color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  .cv-downloads .cv-updated { margin-top: 6px; color: var(--muted); font-size: 13px; }
</style>
