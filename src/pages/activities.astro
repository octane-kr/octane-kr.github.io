---
import ProfileLayout from '../layouts/ProfileLayout.astro';
---

<ProfileLayout title="Activities">
  <article class="profile-page">
    <header class="profile-page-header">
      <h1>Activities</h1>
    </header>

    <section class="profile-activity-section" aria-labelledby="participated-heading">
      <h2 id="participated-heading">
        &lt;Participated conferences, seminars, and schools&gt;
      </h2>

      <ul class="profile-activity-list">
        <li>
          <span class="profile-keep-together">Jul. 27 - 31, 2026</span> :
          2026 Korean Student Combinatorics Workshop
          (KSCW2026) (Gongju Hanok Village, Gongju, Korea)
        </li>
      </ul>
    </section>
  </article>
</ProfileLayout>
