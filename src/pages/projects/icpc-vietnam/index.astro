---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { icpcVietnamContests } from '../../../data/icpcVietnamContests.js';

const years = [...new Set(icpcVietnamContests.map((contest) => contest.year))];
---

<BlogLayout
  title="베트남 ICPC 아카이브"
  description="베트남 ICPC 대회의 VNOJ 업솔빙과 동적 스코어보드"
>
  <article class="vietnam-archive">
    <header class="vietnam-archive-header">
      <h1>베트남 ICPC 아카이브</h1>
      <p>업솔빙과 시점별 스코어보드가 함께 남아 있는 대회를 모았습니다.</p>
    </header>

    <div class="vietnam-year-list">
      {years.map((year) => (
        <section class="vietnam-year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <div class="vietnam-contest-list">
            {icpcVietnamContests
              .filter((contest) => contest.year === year)
              .map((contest) => (
                <div class="vietnam-contest-row">
                  <h3>{contest.stage}</h3>
                  <nav aria-label={`${year} ${contest.stage} 링크`}>
                    <a href={contest.upsolveUrl} target="_blank" rel="noreferrer">
                      업솔빙<span aria-hidden="true">↗</span>
                    </a>
                    {contest.scoreboards.map((scoreboard, index) => (
                      <a href={`/projects/icpc-vietnam/${scoreboard.slug}/`}>
                        {index === 0 ? '스코어보드' : scoreboard.variant}
                      </a>
                    ))}
                  </nav>
                </div>
              ))}
          </div>
        </section>
      ))}
    </div>

    <p class="vietnam-archive-source">
      대회 목록과 원본 순위표는 <a href="https://icpcvn.github.io/" target="_blank" rel="noreferrer">Vietnam ICPC Archives</a>를 따릅니다.
    </p>
  </article>
</BlogLayout>

<style>
  .vietnam-archive {
    max-width: 820px;
    margin: 0 auto;
  }

  .vietnam-archive-header {
    margin-bottom: 34px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }

  .vietnam-archive-header h1 {
    margin: 0;
    font-size: 38px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .vietnam-archive-header p {
    max-width: 620px;
    margin: 10px 0 0;
    color: #4b5563;
    word-break: keep-all;
  }

  .vietnam-year-list {
    display: grid;
    gap: 36px;
  }

  .vietnam-year {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .vietnam-year h2 {
    margin: 15px 0 0;
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .vietnam-contest-list {
    border-top: 1px solid var(--text);
  }

  .vietnam-contest-row {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) auto;
    gap: 20px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .vietnam-contest-row h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: 0;
  }

  .vietnam-contest-row nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 18px;
    font-size: 14px;
  }

  .vietnam-contest-row a,
  .vietnam-archive-source a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .vietnam-contest-row a:hover,
  .vietnam-archive-source a:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }

  .vietnam-contest-row a span {
    margin-left: 3px;
    color: var(--muted);
    font-size: 11px;
  }

  .vietnam-archive-source {
    margin: 38px 0 0 112px;
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .vietnam-archive-header h1 {
      font-size: 31px;
    }

    .vietnam-year {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .vietnam-year h2 {
      margin-top: 0;
    }

    .vietnam-archive-source {
      margin-left: 0;
    }
  }

  @media (max-width: 480px) {
    .vietnam-contest-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .vietnam-contest-row nav {
      justify-content: flex-start;
    }
  }
</style>
