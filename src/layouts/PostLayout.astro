---
import BlogLayout from './BlogLayout.astro';
import PostInteractions from '../components/PostInteractions.astro';
import ReferenceLens from '../components/ReferenceLens.astro';
import { getPostMetadata } from '../lib/postMetadata';

const pathnameParts = Astro.url.pathname.split('/').filter(Boolean);
const postSlug = pathnameParts[pathnameParts.length - 1] ?? '';
const metadata = getPostMetadata(postSlug);

const title = metadata?.title ?? 'Untitled';
const description = metadata?.description ?? '';
const category = metadata?.category ?? 'PS';
const subcategory = metadata?.subcategory ?? '';
const isFilmReview = category === 'Culture' && subcategory === 'Films';

const parseDate = (value) => {
  if (!value) return null;

  const date = value instanceof Date ? value : new Date(value);
  return Number.isNaN(date.valueOf()) ? null : date;
};

const publishedAt = parseDate(metadata?.publishedAt);
const updatedAt = parseDate(metadata?.updatedAt);
const dateFormatter = new Intl.DateTimeFormat('ko-KR', {
  timeZone: 'Asia/Seoul',
  year: 'numeric',
  month: 'numeric',
  day: 'numeric',
});

const formatDate = (date) => {
  if (date === null) return '날짜 없음';

  return dateFormatter.format(date);
};

const hasUpdatedAt =
  publishedAt !== null &&
  updatedAt !== null &&
  formatDate(updatedAt) !== formatDate(publishedAt);

const formatCategory = (category, subcategory) =>
  subcategory ? `${category} / ${subcategory}` : category;

const categoryHref = `/posts/?category=${encodeURIComponent(category)}`;
const subcategoryHref = subcategory
  ? `${categoryHref}&subcategory=${encodeURIComponent(subcategory)}`
  : '';

---

<BlogLayout title={title} description={description}>
  <article class="article">
    <header class="article-header">
      <h1>{title}</h1>
      <div class="article-meta">
        <span class="article-category-meta">
          <a href={categoryHref}>{category}</a>
          {
            subcategory && (
              <>
                <span aria-hidden="true">/</span>
                <a href={subcategoryHref}>{subcategory}</a>
              </>
            )
          }
        </span>
        <span>{formatDate(publishedAt)}</span>
        {hasUpdatedAt && <span>수정 {formatDate(updatedAt)}</span>}
      </div>
      {description && <p>{description}</p>}
    </header>

    <div class="article-body">
      <slot />
    </div>

    <PostInteractions postSlug={postSlug} placement="bottom" showComments={true} />
  </article>

  {!isFilmReview && <ReferenceLens postSlug={postSlug} />}
</BlogLayout>
