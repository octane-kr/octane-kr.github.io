---
interface RecordEntry {
  title: string;
  date: string;
  koreanTitle?: string;
  details?: string[];
  result?: string;
  team?: string;
  reference?: { label: string; url: string };
}
interface Props {
  records: Record<string, RecordEntry>;
  ids: string[];
  style: string;
}
const { records, ids, style } = Astro.props;
const compact = style === 'list';
const placementPattern = /(\b\d+(?:st|nd|rd|th) place(?: overall)?\b)/g;
---

<ul class:list={['cv-records', { 'cv-records-compact': compact }]} role="list">
  {ids.map((id) => {
    const entry = records[id];
    const inlineResult = compact && !entry.team;
    return <li class="cv-record" data-record={id}>
      <div class="cv-record-heading">
        <div class="cv-record-label">
          <span class="cv-record-title">{entry.title}{entry.koreanTitle && <> (<span lang="ko">{entry.koreanTitle}</span>)</>}</span>
          {inlineResult && entry.result && <>{' '}<span class="cv-record-note">(<span class="cv-record-result">{entry.result}</span>)</span></>}
        </div>
        {entry.date && <span class="cv-meta">{entry.date}</span>}
      </div>
      {!inlineResult && (entry.result || entry.team) && <p class="cv-record-outcome">
        {entry.result && <span class="cv-record-result">{entry.result.split(placementPattern).map((part, index) =>
          index % 2 === 0 ? part : <span class="cv-record-placement">{part}</span>
        )}</span>}
        {entry.team && <span class="cv-record-team">{entry.team}</span>}
      </p>}
      {entry.details?.map((detail) => {
        const reference = entry.reference;
        if (reference && detail.includes(reference.label)) {
          const [before, after] = detail.split(reference.label);
          return <p class="cv-record-detail">{before}<a href={reference.url}>{reference.label}</a>{after}</p>;
        }
        return <p class="cv-record-detail">{detail}</p>;
      })}
    </li>;
  })}
</ul>

<style>
  .cv-records { margin: 0; padding: 0; list-style: none; }
  .cv-record + .cv-record { margin-top: 0.85rem; }
  .cv-records-compact .cv-record + .cv-record { margin-top: 0.48rem; }
  .cv-records-compact:has(.cv-record-team) .cv-record + .cv-record { margin-top: 0.76rem; }
  .cv-record-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: baseline;
    column-gap: clamp(0.65rem, 3vw, 1.5rem);
    line-height: 1.5;
  }
  .cv-record-heading:has(.cv-meta) { grid-template-columns: minmax(0, 1fr) auto; }
  .cv-record-label { overflow-wrap: anywhere; text-wrap: pretty; }
  .cv-record-title, .cv-record-result { font-weight: 400; }
  .cv-record-note { color: var(--muted); font-size: 0.875rem; }
  .cv-meta {
    max-inline-size: 24ch;
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    text-align: end;
    overflow-wrap: anywhere;
  }
  .cv-record-outcome, .cv-record-detail {
    margin: 0.12rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .cv-record-outcome {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.85rem;
  }
  .cv-record-result, .cv-record-team { min-inline-size: 0; }
  .cv-record-outcome > .cv-record-result { color: #4b5563; }
  .cv-record-placement { white-space: nowrap; }
  .cv-record-team { color: var(--muted); font-size: 0.8125rem; }
  .cv-record-detail { color: #4b5563; }
  .cv-record-detail a { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 480px) {
    .cv-meta { max-inline-size: 12ch; }
  }
</style>
